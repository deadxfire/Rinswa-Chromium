# ==============================================================================
# RINSWA CHROMIUM BROWSER - GN BUILD CONFIGURATION
# Platform: Windows 10/11 (x64)
# Product: Rinswa Browser v1.0.6
# Author: Arindam Makar
# ==============================================================================

# Release Optimization Flags
is_official_build = true
is_debug = false
symbol_level = 0
blink_symbol_level = 0
is_component_build = false
target_cpu = "x64"
dcheck_always_on = false
chrome_pgo_phase = 0

# Media Codecs & Streaming (Full H.264, AAC, MP4, WebM, WebGPU Support)
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_widevine = true

# Privacy & Security (Zero-Telemetry & De-Googled)
# Disables external telemetry, metric collection, crash reporting, and Google cloud syncing
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
enable_remoting = false
enable_reporting = false
enable_service_discovery = false
enable_mdns = false
enable_hangout_services_extension = false

# Sandbox & Safety
enable_nacl = false
safe_browsing_mode = 1 # Local blocklists without sending browsing URLs to cloud

# UI & Rendering
enable_paint_preview = true
use_system_libjpeg = false
use_system_libpng = false
use_system_zlib = false
