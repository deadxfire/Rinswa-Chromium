{
  "manifest_version": 3,
  "name": "Rinswa Video Popout & Screen Capture",
  "version": "1.0.8",
  "description": "Universal Video Popout (Picture-in-Picture) and Screen Capture (Ctrl+Shift+S) for Rinswa Browser.",
  "author": "Arindam Makar",
  "action": {
    "default_title": "Rinswa Tools & Screen Capture",
    "default_popup": "popup.html",
    "default_icon": "rinswa-logo.png"
  },
  "icons": {
    "128": "rinswa-logo.png"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-screenshot": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "windows": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture Screenshot (Select Area or Full Screen)"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "screenshot.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "universal_pip.js"
      ],
      "css": [
        "universal_pip.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "screenshot.css",
        "rinswa-logo.png"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "key": "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC8ZtnRT6hXtjtG5XM7TcKakx9J+37WuK1g1cx2IOh9enerA5VlQBcoHSpGOx5xzebQLxzUtURmNQXSrhOac/z9SVUhHrXrtnBS4ftIUfagTDroowh1b23pIusQaLKprhkS8iFr0nw887BV+yh9LQ7J90qDNzukXn0ss6ZVMxgcaQIDAQAB"
}
