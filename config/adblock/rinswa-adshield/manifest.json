{
  "manifest_version": 3,
  "name": "Rinswa Shield & Video Popout",
  "version": "1.0.6",
  "description": "Native built-in adblocker, YouTube ad defuser, and Universal Video Popout (Picture-in-Picture) for Rinswa Browser.",
  "author": "Arindam Makar",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": ["youtube_defuser.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": ["universal_pip.js"],
      "css": ["universal_pip.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
