{
  "manifest_version": 3,
  "name": "Rinswa Shield & Video Popout",
  "version": "1.0.6",
  "description": "Native built-in adblocker, YouTube ad defuser, and Universal Video Popout (Picture-in-Picture) for Rinswa Browser.",
  "author": "Arindam Makar",
  "action": {
    "default_title": "Rinswa Shield & Video Popout",
    "default_popup": "popup.html",
    "default_icon": "rinswa-logo.png"
  },
  "icons": {
    "128": "rinswa-logo.png"
  },
  "host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "youtube_defuser.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "universal_pip.js"
      ],
      "css": [
        "universal_pip.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "key": "MIGfMA0GCSqGSIb3DQEBAQUAA4GNADCBiQKBgQC8ZtnRT6hXtjtG5XM7TcKakx9J+37WuK1g1cx2IOh9enerA5VlQBcoHSpGOx5xzebQLxzUtURmNQXSrhOac/z9SVUhHrXrtnBS4ftIUfagTDroowh1b23pIusQaLKprhkS8iFr0nw887BV+yh9LQ7J90qDNzukXn0ss6ZVMxgcaQIDAQAB"
}
