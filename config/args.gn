# ==============================================================================
# RINSWA BROWSER (CHROMIUM ENGINE) - MASTER GN CONFIGURATION
# Platform: Windows 10 / 11 (x64)
# Product:  Rinswa Browser v1.0.6 Stable
# Author:   Arindam Makar
# Target:   chrome.exe & mini_installer.exe
# ==============================================================================

# Release Optimization Directives
is_official_build = true
is_debug = false
symbol_level = 0
blink_symbol_level = 0
is_component_build = false
target_cpu = "x64"
dcheck_always_on = false
chrome_pgo_phase = 0

# Media Codecs & Hardware Acceleration
# Enables high-performance playback for H.264, AAC, MP4, WebM, and Widevine DRM
proprietary_codecs = true
ffmpeg_branding = "Chrome"
enable_widevine = true

# Absolute Privacy & Zero Telemetry Directives (De-Googled)
# Neutralizes background telemetry, Google sync, metric uploads, and client-side profiling
google_api_key = ""
google_default_client_id = ""
google_default_client_secret = ""
enable_remoting = false
enable_reporting = false
enable_service_discovery = false
enable_mdns = false
enable_hangout_services_extension = false

# Security & Sandboxing
enable_nacl = false
safe_browsing_mode = 1

# Performance & Memory Tuning
enable_paint_preview = true
use_system_libjpeg = false
use_system_libpng = false
use_system_zlib = false
