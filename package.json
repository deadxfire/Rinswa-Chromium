{
  "name": "rinswa-browser",
  "productName": "Rinswa",
  "version": "1.0.6",
  "description": "A fast, private, and stunning modern Chromium-based web browser featuring Cyber-Glass UI, native ad blocking, and Smart Tabs.",
  "main": "src/main/index.js",
  "author": "Arindam Makar",
  "license": "MPL-2.0",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.rinswa.browser",
    "productName": "Rinswa",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "Glossy Multicolour Ribbon R Emblem.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "Glossy Multicolour Ribbon R Emblem.ico",
      "uninstallerIcon": "Glossy Multicolour Ribbon R Emblem.ico",
      "installerHeaderIcon": "Glossy Multicolour Ribbon R Emblem.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rinswa Browser"
    }
  },
  "devDependencies": {
    "electron": "^34.0.0"
  }
}
